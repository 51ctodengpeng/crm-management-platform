# ============================================================================
# CRM 运行环境变量（systemd EnvironmentFile）
# 实际路径：/opt/crm/deploy/crm.env      权限：chmod 600，属主 crm:crm
# 参考模板：/opt/crm/deploy/crm.env.example
# 改完执行：systemctl restart crm
# ============================================================================

# ---------- Flask ----------
# 会话与 CSRF 签名密钥，泄露等于可伪造任意登录态；用 32 字节随机十六进制
CRM_SECRET_KEY=CHANGE_ME_32_BYTE_HEX
# 运行环境标记：prod 下即使误设 CRM_DEBUG=1 也不会开启 Werkzeug 调试器
CRM_ENV=prod
# 空闲超时（分钟），超过自动登出
CRM_SESSION_IDLE_MINUTES=120
# 首次建库时的管理员初始口令（install.sh 会自动生成随机值并打印一次）
# 账号表非空时该项不生效；登录后请立即在「修改密码」中更换
CRM_ADMIN_PASSWORD=
# 公开注册开关：内网可保留默认（开放）；对公网开放时建议取消下面这行注释
# CRM_ALLOW_REGISTER=0

# ---------- 反向代理 ----------
# 在 Nginx 后面必须为 1：信任 X-Forwarded-Proto/For，否则生成的链接会是 http
CRM_BEHIND_PROXY=1
# 全站 HTTPS 后置 1：会话 Cookie 带 Secure，明文通道拿不到登录态
CRM_COOKIE_SECURE=1

# ---------- 数据目录（可写，持久） ----------
# 附件、头像、备份、暂存导入文件都在这里；数据库不在本地（见下方 MySQL）
CRM_DATA_DIR=/opt/crm
CRM_UPLOAD_DIR=/opt/crm/uploads
CRM_AVATAR_DIR=/opt/crm/avatars

# ---------- MySQL 8 ----------
# 只要设了 CRM_DB_HOST 就走 MySQL，否则回落到 SQLite 单文件（桌面版行为）
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=3306
CRM_DB_NAME=crm
CRM_DB_USER=crm
CRM_DB_PASSWORD=CHANGE_ME
